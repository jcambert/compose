{
  "name": "@jc90100/compose",
  "version": "0.1.2",
  "description": "Professional Node.js CLI for discovering, managing and executing Docker Compose projects.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcambert/compose"
  },
  "bugs": {
    "url": "https://github.com/jcambert/compose/issues"
  },
  "homepage": "https://github.com/jcambert/compose#readme",
  "bin": {
    "compose": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "clean": "node -e \"import('node:fs/promises').then(fs => fs.rm('dist', { recursive: true, force: true }))\"",
    "lint": "eslint .",
    "start": "node dist/cli/index.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck:cli && npm run typecheck:ui",
    "typecheck:cli": "tsc --noEmit",
    "typecheck:ui": "tsc --project ui/tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "smoke": "node scripts/smoke-test.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run audit && npm run build && npm run smoke && npm run pack:dry-run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "execa": "^9.5.0",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "docker",
    "compose",
    "docker-compose",
    "cli",
    "typescript"
  ],
  "license": "MIT"
}
